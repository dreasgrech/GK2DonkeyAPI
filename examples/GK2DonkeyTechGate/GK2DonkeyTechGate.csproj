<Project Sdk="Microsoft.NET.Sdk">

  <!-- Example for mod authors (docs/api.md): gating the mount on the game's tech tree. Not shipped. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2DonkeyTechGate</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Your own mod would reference the installed or released GK2DonkeyAPI.dll with a HintPath instead. -->
    <ProjectReference Include="..\..\src\GK2DonkeyAPI\GK2DonkeyAPI.csproj" Private="false" />
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- An example: not deployed by default, so normal play doesn't get its rules (the cart style gated by a tech).
       Build with -p:Deploy=true to put it into the game (only while the game is closed). -->
  <PropertyGroup>
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
