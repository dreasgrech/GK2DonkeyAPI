<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only: the in-game integration tests of the mods built on the GK2 Donkey API (GK2 Saddle Up and its packs),
       and the plugin that hands the API's scenarios and these to GK2 Mod Test Bench, which runs them (F4; until
       2026-11-17 the API had a runner of its own under F11's Tests tab). Moved out of the API on 2026-10-27 (the user:
       the API "doesnt know" about Saddle Up): the API knows only that its tests exist (Dev/AssemblyInfo.cs,
       InternalsVisibleTo), never the mods they test, nor the bench. Never shipped.
       Build order: the bench deployed into the game (its own repository: dotnet build -c Release -p:Deploy=true),
       the API built in Release, then this with -p:Deploy=true (the game closed). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2DonkeyAPI.IntegrationTests</AssemblyName>
    <RootNamespace>GK2DonkeyAPI.IntegrationTests</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- MSB3277 (System.IO.Compression 4.1.3.0 against 4.2.0.0) is the game's own, as in GK2DonkeyAPI.csproj. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API's own build output, not a ProjectReference: building the tests must never rebuild the API (the dist copy
         and the release scans read that folder). Build the API first. -->
    <Reference Include="GK2DonkeyAPI"><HintPath>$(MSBuildThisFileDirectory)..\..\src\GK2DonkeyAPI\bin\Release\netstandard2.1\GK2DonkeyAPI.dll</HintPath><Private>false</Private></Reference>
    <!-- GK2 Mod Test Bench as deployed in the game (Directory.Build.props, TestBenchDll): the runner and the panel. -->
    <Reference Include="GK2ModTestBench"><HintPath>$(TestBenchDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(Managed)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Managed)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Dev-only, so it does NOT deploy by default: a plain build must never put a test plugin into the player's game.
       -p:Deploy=true puts it into the game, only while the game is closed. -->
  <PropertyGroup>
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
