# Build output
bin/
obj/

# IDE / user files
.vs/
.idea/
*.user
*.suo
*.swp

# OS
Thumbs.db
.DS_Store

# Cargo sheet pictures (generated by the dev panel; the layout file is the source)
tools/cargo-sheet/out/

# Frame sheets drawn by tools/frames*.py
tools/frames-out/

# The release zips in release/ ARE kept in git (the user, 2026-10-30: two public zips were overwritten and lost on this
# machine while release/ was ignored); only the logs of tools/build-dist.sh and release-scans.sh are not
release/logs/

*.un~
# an editor's / SmartGit's copy of a file as last saved (~CHANGELOG.md.saved.bak): never part of the repo
~*.saved.bak

# Steam Workshop staging folders (tools/make-release-zip.py writes workshop/<Item>/ for the game's Shift+F11 uploader);
# the root folder only: media/workshop/ holds the items' thumbnails and is kept
/workshop/

# Python's compile cache (written by any run of a tool); never part of the repo
__pycache__/
*.pyc
