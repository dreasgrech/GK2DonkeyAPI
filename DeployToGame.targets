<Project>
  <!-- Copies the built plugin into its own folder, $(GameDir)\BepInEx\plugins\$(AssemblyName) (the release zips' layout),
       after every build, but only while the game is closed: a running game has the old DLL loaded, and Windows still
       lets the file be replaced under it, so the check has to be explicit. -p:Deploy=false skips deploying altogether.
       Imported by each plugin's .csproj. A copy left loose in plugins\ by the old layout (before 2026-10-16) is removed,
       so the plugin never loads twice. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq GraveyardKeeper2.exe&quot; /NH" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GameProcessList" />
    </Exec>
    <PropertyGroup>
      <GameRunning>false</GameRunning>
      <GameRunning Condition="$(GameProcessList.Contains('GraveyardKeeper2.exe'))">true</GameRunning>
      <PluginFolder>$(GameDir)\BepInEx\plugins\$(AssemblyName)</PluginFolder>
      <LooseCopy>$(GameDir)\BepInEx\plugins\$(TargetFileName)</LooseCopy>
    </PropertyGroup>
    <Warning Condition="'$(GameRunning)' == 'true'" Text="Graveyard Keeper 2 is running: $(TargetFileName) was built but NOT deployed. Close the game and build again." />
    <MakeDir Condition="'$(GameRunning)' != 'true'" Directories="$(PluginFolder)" />
    <Copy Condition="'$(GameRunning)' != 'true'" SourceFiles="$(TargetPath)" DestinationFolder="$(PluginFolder)" />
    <Message Condition="'$(GameRunning)' != 'true' And Exists('$(LooseCopy)')" Importance="high" Text="Removed the old loose copy $(LooseCopy)" />
    <Delete Condition="'$(GameRunning)' != 'true' And Exists('$(LooseCopy)')" Files="$(LooseCopy)" />
    <Message Condition="'$(GameRunning)' != 'true'" Importance="high" Text="Deployed $(TargetFileName) to $(PluginFolder)" />
  </Target>
</Project>
