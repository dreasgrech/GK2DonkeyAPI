<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2DonkeyAPI</AssemblyName>
    <Version>0.42.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A release build (-p:ForDist=true) carries no debug directory: the PDB path would bake this machine's user
         folder into the shipped DLL. -->
    <DebugType Condition="'$(ForDist)' == 'true'">none</DebugType>
    <!-- MSB3277 (System.IO.Compression 4.1.3.0 against 4.2.0.0) is the game's own: its Assembly-CSharp is built against
         4.2.0.0, yet it ships 4.0.0.0 in Managed (no 4.2.0.0 exists anywhere), and Mono unifies them at load. The mod
         uses none of it. Checked 2026-10-03 by referencing the game's copy: the conflict only moved to 4.0.0.0. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="defaults.cfg" LogicalName="GK2DonkeyAPI.defaults.cfg" />
    <EmbeddedResource Include="cargo-layout.cfg" LogicalName="GK2DonkeyAPI.cargo-layout.cfg" />
    <EmbeddedResource Include="cargo-shapes.cfg" LogicalName="GK2DonkeyAPI.cargo-shapes.cfg" />
    <!-- How a changed game member is treated, by the mod's class that uses it (GameCode.cs, docs/dependency-check.md). -->
    <EmbeddedResource Include="game-code.txt" LogicalName="GK2DonkeyAPI.game-code.txt" />
    <!-- The cart lantern's mesh data (vertex and index buffers of donkey_cart_lantern-MERGE S_OBJ, read from the
         game's bundle; the mesh is not readable at runtime). LampHang.cs splits it into pole and hanging lamp. -->
    <EmbeddedResource Include="assets\lantern-vertices.bin" LogicalName="GK2DonkeyAPI.lantern-vertices.bin" />
    <EmbeddedResource Include="assets\lantern-indices.bin" LogicalName="GK2DonkeyAPI.lantern-indices.bin" />
    <!-- the self-tests' embedded pack (a donkey skin with an .ogg and a .wav: the route the built-in packs' sounds
         take); never registered at start -->
    <EmbeddedResource Include="assets\testmounts\**\*" LogicalName="GK2DonkeyAPI.testmounts.%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- No mounts or skins here: the API is the backend and ships the donkey alone; every mount and skin is a
         mod's own (embedded in that mod's csproj; docs/mounts-as-mods.md). -->
  </ItemGroup>

  <!-- The source folder, so the panel can read and write defaults.cfg / cargo-layout.cfg in place on this machine.
       Left out of a release build (-p:ForDist=true): the DLL then uses its embedded copies and the panel has no
       "Make these the mod defaults" button. -->
  <ItemGroup Condition="'$(ForDist)' != 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GK2DonkeyAPISourceDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LazyBearTechnology"><HintPath>$(Managed)\LazyBearTechnology.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cinemachine"><HintPath>$(Managed)\Cinemachine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(Managed)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AstarPathfindingProject"><HintPath>$(Managed)\AstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FlowCanvas"><HintPath>$(Managed)/FlowCanvas.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NodeCanvas"><HintPath>$(Managed)/NodeCanvas.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ParadoxNotion"><HintPath>$(Managed)/ParadoxNotion.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Managed)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(Managed)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(Managed)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(Managed)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(Managed)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(Managed)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <!-- Optional at runtime: only FrameworkLink uses it, and only when the framework is installed. -->
    <Reference Include="GK2.Framework"><HintPath>$(FrameworkDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The dependency check: shared sources, Mono.Cecil, and the manifest embedded after every build (docs/dependency-check.md). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DependencyManifest.targets" />
  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />


</Project>
