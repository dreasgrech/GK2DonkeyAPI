<Project Sdk="Microsoft.NET.Sdk">

  <!-- The playable mount built on the GK2 Donkey API. Ships in one zip
       with GK2DonkeyAPI.dll, which it needs (hard dependency). Its built-in content (Gerry, the donkey's Hellfire and
       Royal Parade) is mount packs in assets\mounts\ (mount.cfg, sounds\, skins\<skin>\ with skin.cfg and its
       pictures), embedded here and registered with the API at start (Plugin.cs). The other mounts are external packs
       of their own in the repo's packs\<Pack>\ (the dragon; the rat, snail and worm), each its own download, found by
       the API like any mod's pack (docs/making-a-mount.md "Built in or external"); a dev build links them into the
       game (LinkPacks below). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2SaddleUp</AssemblyName>
    <Version>0.12.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A release build (-p:ForDist=true) carries no debug directory: the PDB path would bake this machine's user
         folder into the shipped DLL. -->
    <DebugType Condition="'$(ForDist)' == 'true'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packs, by the name pattern Mounts.Looks.RegisterEmbedded reads: <prefix><mount>\mount.cfg,
         <prefix><mount>\sounds\<file>, <prefix><mount>\skins\<skin>\<file>. -->
    <EmbeddedResource Include="assets\mounts\**\*" LogicalName="GK2SaddleUp.mounts.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The packs' source folder, so the API's Mounts tab (F11) can write tuned values back into a skin's skin.cfg and a
       mount's mount.cfg on this machine (the same as the API's own GK2DonkeyAPISourceDir). Left out of a release build. -->
  <ItemGroup Condition="'$(ForDist)' != 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GK2MountsSourceDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\assets\mounts</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GK2DonkeyAPI\GK2DonkeyAPI.csproj" Private="false" />
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

  <!-- The external packs (the repo's packs\<Pack>\) linked into the game with the DLL, so the two never part: an old
       DLL still holding a mount beside its pack would show it twice. A directory junction (no admin needed), made only
       where there is nothing of that name: a real folder there (an unzipped copy) is left alone and said. The F11
       Mounts tab then saves into the repo. tools/packs.py status | link | unlink does the same by hand; unlink removes
       the links only (docs/release-checklist.md: before the zip rehearsal). -->
  <Target Name="LinkPacks" AfterTargets="DeployToGame" Condition="'$(Deploy)' != 'false' And '$(GameRunning)' != 'true' And Exists('$(MSBuildThisFileDirectory)..\..\packs')">
    <ItemGroup>
      <PackDir Include="$([System.IO.Directory]::GetDirectories('$(MSBuildThisFileDirectory)..\..\packs'))" />
    </ItemGroup>
    <Exec Condition="!Exists('$(GameDir)\BepInEx\plugins\%(PackDir.Filename)%(PackDir.Extension)')" Command="mklink /J &quot;$(GameDir)\BepInEx\plugins\%(PackDir.Filename)%(PackDir.Extension)&quot; &quot;%(PackDir.FullPath)&quot;" StandardOutputImportance="low" />
    <Message Importance="high" Text="Packs linked into $(GameDir)\BepInEx\plugins: @(PackDir->'%(Filename)%(Extension)', ', ') (tools/packs.py status)" />
  </Target>

</Project>
