<Project Sdk="Microsoft.NET.Sdk">

  <!-- The playable mount built on the GK2 Donkey API. Ships in one zip
       with GK2DonkeyAPI.dll, which it needs (hard dependency). Its five mounts (the Red Dragon, the Giant Rat, the
       Giant Snail, the Giant Worm, Gerry) are skin packs in assets\skins\<id>\ (skin.cfg and a PNG per frame, front\
       for the dragon's near wing; Gerry's a cfg alone), embedded here and registered with the API at start
       (Plugin.cs): the API is the backend, the player mod ships the content, the way any mod ships a mount
       (docs/mounts-as-mods.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2SaddleUp</AssemblyName>
    <Version>0.12.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A release build (-p:ForDist=true) carries no debug directory: the PDB path would bake this machine's user
         folder into the shipped DLL. -->
    <DebugType Condition="'$(ForDist)' == 'true'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packs, by the name pattern Mounts.Looks.RegisterEmbedded reads: <prefix><skin dir>\<file>. -->
    <EmbeddedResource Include="assets\skins\**\*" LogicalName="GK2SaddleUp.skins.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The packs' source folder, so the API's Mounts tab (F11) can write a skin's tuned values back into its skin.cfg on
       this machine (the same as the API's own GK2DonkeyAPISourceDir). Left out of a release build. -->
  <ItemGroup Condition="'$(ForDist)' != 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GK2SkinsSourceDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\assets\skins</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GK2DonkeyAPI\GK2DonkeyAPI.csproj" Private="false" />
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
