<Project Sdk="Microsoft.NET.Sdk">

  <!-- The playable mount built on the GK2 Donkey API. Ships in one zip
       with GK2DonkeyAPI.dll, which it needs (hard dependency). Its built-in content (Gerry) is a mount pack in
       assets\mounts\ (mount.cfg, sounds\, skins\<skin>\ with skin.cfg and its pictures), embedded here and registered
       with the API at start (Plugin.cs). Every other mount and skin is a mod or a pack of its own, registered with the
       API (the repo's packs\<Pack>\ are such packs), each a small plugin of its own
       with its folder embedded, its own download (docs/making-a-mount.md "Built in or external"). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GK2SaddleUp</AssemblyName>
    <Version>0.14.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- A release build (-p:ForDist=true) carries no debug directory: the PDB path would bake this machine's user
         folder into the shipped DLL. -->
    <DebugType Condition="'$(ForDist)' == 'true'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packs, by the name pattern Mounts.Looks.RegisterEmbedded reads: <prefix><mount>\mount.cfg,
         <prefix><mount>\sounds\<file>, <prefix><mount>\skins\<skin>\<file>. -->
    <EmbeddedResource Include="assets\mounts\**\*" LogicalName="GK2SaddleUp.mounts.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The packs' source folder, so the API's Mounts tab (F11) can write tuned values back into a skin's skin.cfg and a
       mount's mount.cfg on this machine (the same as the API's own GK2DonkeyAPISourceDir). Left out of a release build. -->
  <ItemGroup Condition="'$(ForDist)' != 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GK2MountsSourceDir</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\assets\mounts</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GK2DonkeyAPI\GK2DonkeyAPI.csproj" Private="false" />
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploys into the game after every build, only while it is closed (-p:Deploy=false skips it). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />

</Project>
